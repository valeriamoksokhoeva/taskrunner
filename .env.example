# All variables are optional; defaults live in config.defaults().
# Durations use Go syntax: 100ms, 1.5s, 2m.

TR_PORT=8080
TR_ENV=dev

TR_N_WORKERS=8
TR_CHAN_CAP=64
TR_SEM_CAP=4

TR_CAPACITY=10
TR_TICKER_TIME=100ms
TR_TOKEN_WAIT=500ms

TR_ENQUEUE_TIMEOUT=5s
TR_TASK_TIMEOUT=3s
TR_SIMULATE_FOR=200ms
TR_SHUTDOWN_HTTP=10s
TR_SHUTDOWN_WORKERS=15s

# reject -> 503 immediately | block -> wait for room
TR_OVERFLOW=reject
# sleep -> simulate work | http -> real GET against the submitted url
TR_MODE=sleep
# mutex -> map + RWMutex | syncmap -> sync.Map
TR_STORE=mutex
